{
  "name": "@blwatkins/color-utils",
  "version": "0.1.0-alpha.0",
  "license": "MIT",
  "private": false,
  "description": "A toolkit of library-agnostic TypeScript and JavaScript utilities for creating and managing colors.",
  "author": {
    "name": "Brittni Watkins",
    "url": "https://blwatkins.github.io/"
  },
  "homepage": "https://blwatkins.github.io/typescript-color-utils/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blwatkins/typescript-color-utils.git"
  },
  "bugs": {
    "url": "https://github.com/blwatkins/typescript-color-utils/issues"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://github.com/sponsors/blwatkins"
    }
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.0 || >=24"
  },
  "types": "./_dist/index.d.mts",
  "module": "./_dist/index.mjs",
  "main": "./_dist/index.mjs",
  "exports": {
    ".": {
      "types": "./_dist/index.d.mts",
      "default": "./_dist/index.mjs"
    }
  },
  "files": [
    "./_dist",
    "./LICENSE",
    "./package.json",
    "./README.md"
  ],
  "scripts": {
    "lint:js": "eslint -c eslint.config.js.mjs .",
    "lint:ts": "eslint -c eslint.config.ts.mjs .",
    "lint:all": "npm run lint:js && npm run lint:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "build": "tsdown",
    "prepack": "npm run build",
    "validate": "npm run lint:all && npm run docs && npm run build && npm test"
  },
  "dependencies": {
    "@blwatkins/utils": "alpha",
    "chroma-js": "^3.2.0",
    "typebox": "^1.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chroma-js": "^3.1.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-es-x": "^10.1.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "globals": "^17.13.0",
    "tsdown": "^0.23.3",
    "typedoc": "^0.28.19",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@types/chroma-js": "^3.1.3"
  },
  "keywords": [
    "typescript",
    "javascript",
    "utility",
    "utilities",
    "utils",
    "esm",
    "color"
  ]
}
